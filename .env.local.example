# Google OAuth credentials for JoshReadingOnline
# Use a Google Cloud OAuth app that allows joshualparris@gmail.com.
# For a personal Gmail account, the OAuth consent screen usually needs to be External
# with joshualparris@gmail.com added as a test user while the app is unpublished.
# Project ID: your_google_cloud_project_id
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Google API Key for Picker API (must be NEXT_PUBLIC_ to be available in the browser)
# Get this from Google Cloud Console → APIs & Services → Credentials → API Keys
# Ensure the key is authorized for Drive API and Picker API
NEXT_PUBLIC_GOOGLE_API_KEY=your_api_key_here

# NextAuth configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Optional: only allow this Google account to sign in.
ALLOWED_GOOGLE_EMAIL=joshualparris@gmail.com

# Optional: Google Drive folder IDs for the fixed library sections.
# Leave blank until you create/select matching folders in the Gmail Drive.
GOOGLE_DRIVE_FOLDER_IT_PD_EBOOKS=
GOOGLE_DRIVE_FOLDER_BOOK_CLUB=
GOOGLE_DRIVE_FOLDER_UNSORTED=
GOOGLE_DRIVE_FOLDER_AVANCE_KBS=
GOOGLE_DRIVE_FOLDER_ITIL_PDFS=
GOOGLE_DRIVE_FOLDER_ITIL=
GOOGLE_DRIVE_FOLDER_ITIL_PRINCE_COBIT=
GOOGLE_DRIVE_FOLDER_IEC_27001=

# Optional audiobook folder IDs. NEXT_PUBLIC_* is used for browser links.
GOOGLE_DRIVE_AUDIOBOOK_FOLDER_OUTLANDER=
GOOGLE_DRIVE_AUDIOBOOK_FOLDER_OTHER=
NEXT_PUBLIC_GOOGLE_DRIVE_AUDIOBOOK_FOLDER_OUTLANDER=
NEXT_PUBLIC_GOOGLE_DRIVE_AUDIOBOOK_FOLDER_OTHER=

# Optional: point at a local "BookShelf Rescue YYYY-MM-DD" folder.
# When set, BookShelf can list/read rescued local books without Google sign-in.
BOOKSHELF_LOCAL_LIBRARY_PATH=
